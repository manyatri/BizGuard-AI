# BizGuard AI — Environment Configuration

# Database
# Local SQLite development:
DATABASE_URL=sqlite:///./bizguard.db
# Production / Docker PostgreSQL:
# DATABASE_URL=postgresql://bizguard_user:bizguard_password@localhost:5432/bizguard_db

# Multi-Agent Switch Protocol
SWITCH_BUS_URL=ws://127.0.0.1:8765/switch-bus
SWITCH_AGENT_ID=bizguard-orchestrator-01

# AI Reasoning Providers (Optional — structured mock fallbacks enabled if omitted)
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mattermost Collaboration Webhook (Optional)
MATTERMOST_WEBHOOK_URL=
MATTERMOST_CHANNEL=#bizguard-war-room

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
